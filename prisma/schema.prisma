// Esquema de TripMind. Los objetos anidados (preferencias, ritmo, presupuesto, snapshots de
// lugares, precios) se guardan como JSON y se validan con los esquemas Zod de `src/domain`.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  pending
  booked
  ticket_purchased
  cancelled
}

enum BookingRequirement {
  ticket_required
  booking_recommended
  free
  no_booking
  unverified
}

enum ActivityKind {
  visit
  meal
  event
  free_time
  custom
}

enum TravelMode {
  walk
  car
  transit
  bike
}

enum LegQuality {
  routed
  approximate
}

model Trip {
  id                       String         @id @default(cuid())
  title                    String?
  /// GeocodeResult (con source e isDemo)
  destination              Json
  destinationName          String
  startDate                DateTime       @db.Date
  endDate                  DateTime       @db.Date
  adults                   Int
  children                 Int            @default(0)
  /// Preferences
  preferences              Json
  /// Pace
  pace                     Json
  /// Budget
  budget                   Json
  /// AccommodationPreferences
  accommodationPreferences Json?
  hotel                    Hotel?
  days                     ItineraryDay[]
  favorites                Favorite[]
  /// ItineraryMeta (último cálculo del optimizador)
  itineraryMeta            Json?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

model Hotel {
  id            String        @id @default(cuid())
  tripId        String        @unique
  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// Id del proveedor ("osm:node/…") si el hotel viene de una fuente; null si es manual
  placeId       String?
  /// Snapshot Place
  place         Json?
  name          String
  lat           Float
  lng           Float
  /// Address
  address       Json?
  checkIn       DateTime      @db.Date
  checkOut      DateTime      @db.Date
  /// Price
  price         Json?
  bookingStatus BookingStatus @default(pending)
  bookingUrl    String?
  /// Nota del usuario sobre su reserva
  bookingNote   String?
  /// PaidPrice: lo que el usuario anota como pagado (total)
  paidPrice     Json?
}

model ItineraryDay {
  id         String     @id @default(cuid())
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  isRestDay  Boolean    @default(false)
  activities Activity[]
  legs       Leg[]

  @@unique([tripId, date])
}

model Activity {
  id                 String             @id @default(cuid())
  dayId              String
  day                ItineraryDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  position           Int
  kind               ActivityKind
  title              String
  placeId            String?
  /// Snapshot Place
  place              Json?
  /// "HH:MM"
  startTime          String?
  durationMinutes    Int
  locked             Boolean            @default(false)
  bookingRequirement BookingRequirement @default(unverified)
  bookingStatus      BookingStatus?
  /// BookingLink[]
  bookingLinks       Json               @default("[]")
  /// Price
  price              Json?
  /// Nota del usuario sobre su reserva
  bookingNote        String?
  /// PaidPrice: lo que el usuario anota como pagado (total)
  paidPrice          Json?
  notes              String?
  /// ActivityPlanning (franja, estimaciones, horario, avisos, alternativa)
  planning           Json?

  @@index([dayId, position])
}

model Leg {
  id              String       @id @default(cuid())
  dayId           String
  day             ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  position        Int
  fromActivityId  String?
  toActivityId    String?
  fromLat         Float
  fromLng         Float
  toLat           Float
  toLng           Float
  mode            TravelMode
  quality         LegQuality
  durationMinutes Float?
  distanceMeters  Float?
  /// [lng, lat][]
  geometry        Json?
  externalUrl     String?
  /// Source (obligatoria si quality = routed)
  source          Json?
  isDemo          Boolean?
  /// Margen reservado por el optimizador (estimación local, minutos)
  reservedMinutes Float?

  @@index([dayId, position])
}

model Favorite {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  placeId   String
  /// Snapshot Place
  place     Json
  /// SavedMedia: vídeo de TikTok/Instagram desde el que se guardó (enlace y metadatos oEmbed)
  media     Json?
  createdAt DateTime @default(now())

  @@unique([tripId, placeId])
}

/// Caché de respuestas de proveedores externos (clave + TTL) para no repetir llamadas.
model ProviderCache {
  key       String   @id
  provider  String
  value     Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

enum FeedbackKind {
  error
  idea
  mejora
}

enum FeedbackStatus {
  new
  read
  done
}

/// Buzón de ideas, mejoras y errores que envía el usuario desde la app (Fase 8b).
/// `tripId` no es una relación: el comentario se conserva aunque se borre el viaje.
model Feedback {
  id        String         @id @default(cuid())
  kind      FeedbackKind
  message   String
  /// FeedbackImage[] (base64 comprimido en el navegador)
  images    Json
  /// Contexto automático sin datos personales (viewport, dpr, modo, navegador)
  context   Json
  path      String
  tripId    String?
  status    FeedbackStatus @default(new)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, createdAt])
}
