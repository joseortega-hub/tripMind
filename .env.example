# Copia a .env y ajusta. Nunca subas .env al repositorio.
DATABASE_URL="postgresql://tripmind:tripmind@localhost:5432/tripmind"
# Puerto del host para el Postgres de Docker (cámbialo, y DATABASE_URL, si 5432 está ocupado)
TRIPMIND_DB_PORT=5432

# "auto": usa proveedores reales si están configurados y demo si no. "demo": siempre fixtures.
PROVIDERS_MODE="auto"

# Estilo de mapa (OpenFreeMap no requiere clave; atribución OSM obligatoria)
MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Email de contacto para el User-Agent de Nominatim/Overpass (política de uso)
CONTACT_EMAIL=""

# Opcionales
OPENROUTESERVICE_API_KEY=""
TICKETMASTER_API_KEY=""
GOOGLE_PLACES_API_KEY=""
ANTHROPIC_API_KEY=""
